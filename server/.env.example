# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hunarhub?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret

# development | production
NODE_ENV=development

# Cloudinary (used for profile and product image uploads)
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Set to your deployed frontend URL in production so CORS allows it
CLIENT_URL=http://localhost:3000
